{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Geography",
  "description": "ภูมิภาค (Geography) ของประเทศไทย",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "รหัสภูมิภาค (Primary Key)" },
    "name": {
      "type": "object",
      "description": "ชื่อภูมิภาค",
      "properties": {
        "th": { "type": "string", "maxLength": 255 },
        "en": { "type": "string", "maxLength": 255 }
      },
      "required": ["th", "en"]
    }
  },
  "required": ["id", "name"]
}
