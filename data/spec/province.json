{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Province",
  "description": "จังหวัดของประเทศไทย",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "รหัสจังหวัด (Primary Key)" },
    "name": {
      "type": "object",
      "description": "ชื่อจังหวัด",
      "properties": {
        "th": { "type": "string", "maxLength": 150 },
        "en": { "type": "string", "maxLength": 150 }
      },
      "required": ["th", "en"]
    },
    "prefix": {
      "type": ["object", "null"],
      "description": "จังหวัดไม่มีคำนำหน้า → null (คง key ไว้ให้ schema สม่ำเสมอ)",
      "properties": {
        "th": { "type": "string", "maxLength": 30 },
        "en": { "type": "string", "maxLength": 30 }
      }
    },
    "geography_id": { "type": "integer", "description": "FK → geographies.id" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "name", "prefix", "geography_id"]
}
