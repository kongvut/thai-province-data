{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubDistrict",
  "description": "ตำบล/แขวง (Sub-district) ของประเทศไทย",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "รหัสตำบล (Primary Key)" },
    "zip_code": { "type": "integer", "description": "รหัสไปรษณีย์ 5 หลัก" },
    "name": {
      "type": "object",
      "description": "ชื่อตำบล/แขวง (ไม่มีคำนำหน้า)",
      "properties": {
        "th": { "type": "string", "maxLength": 150 },
        "en": { "type": "string", "maxLength": 150 }
      },
      "required": ["th", "en"]
    },
    "prefix": {
      "type": "object",
      "description": "คำนำหน้า ('ตำบล'/'แขวง' หรือ 'Tambon'/'Khwaeng')",
      "properties": {
        "th": { "type": "string", "maxLength": 30 },
        "en": { "type": "string", "maxLength": 30 }
      },
      "required": ["th", "en"]
    },
    "district_id": { "type": "integer", "description": "FK → districts.id" },
    "lat": { "type": ["number", "null"], "description": "ละติจูด (ถ้ามี)" },
    "long": { "type": ["number", "null"], "description": "ลองจิจูด (ถ้ามี)" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "zip_code", "name", "prefix", "district_id"]
}
